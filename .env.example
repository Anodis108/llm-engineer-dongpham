# ─── Backend (Buổi 2: Local Serving) ─────────────────────────────────────────
# openai = OpenAI Cloud | ollama = Ollama local | vllm = vLLM server
LLM_BACKEND=openai
# Override base_url (để trống = dùng mặc định của backend):
#   ollama → http://localhost:11434/v1
#   vllm   → http://localhost:8000/v1
LLM_BASE_URL=

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Chỉ cần key thật khi LLM_BACKEND=openai. Backend local dùng key giả tự động.
# Có thể đặt NHIỀU key, ngăn cách bằng dấu phẩy, để bật key rotation.
#   OPENAI_API_KEYS=sk-key-1,sk-key-2,sk-key-3
OPENAI_API_KEYS=sk-your-key-here

# Model dùng cho chat completions.
#   openai → gpt-4o-mini
#   ollama → llama3.2:3b  hoặc  legal-assistant (tạo từ Modelfile)
LLM_MODEL=gpt-4o-mini

# ─── Generation params (mặc định, có thể override mỗi request) ────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_COMPLETION_TOKENS=800
LLM_TOP_P=1.0

# ─── Resilience ──────────────────────────────────────────────────────────────
LLM_MAX_RETRIES=5

# ─── Embeddings & Vector Store (Buổi 4) ──────────────────────────────────────
# Embedding dùng OpenAI (cần OPENAI_API_KEYS ở trên, kể cả khi chat chạy local).
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Qdrant: ":memory:" cho demo (không cần Docker). Production: http://localhost:6333
QDRANT_URL=:memory:
VECTORSTORE_COLLECTION=legal_docs

# ─── RAG Pipeline (Buổi 5) ───────────────────────────────────────────────────
RAG_SOURCE_DIR=./data/legal_docs
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
# Contextual Retrieval: prepend heading path (H1 > H2) vào chunk markdown.
RAG_CONTEXTUAL_CHUNKING=true
RAG_TOP_K=5
# Query rewriting: LLM viết lại câu hỏi trước khi search (tốn thêm 1 lời gọi LLM).
RAG_QUERY_REWRITING=false
# Re-ranking bằng cross-encoder (cần cài sentence-transformers, tải model).
RAG_RERANK_ENABLED=false
RAG_FETCH_K=20
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ─── Agentic RAG / CRAG (Buổi 6) ─────────────────────────────────────────────
# Web search fallback khi retrieval không đủ tốt. Free tier tại https://tavily.com
TAVILY_API_KEY=tvly-your-key-here
# Chỉ decompose câu hỏi dài/phức tạp (heuristic theo số ký tự).
AGENT_DECOMPOSE_MIN_CHARS=80
AGENT_MAX_SUB_QUESTIONS=4
# Số chunk "relevant" tối thiểu để KHÔNG cần web search.
AGENT_MIN_RELEVANT_CHUNKS=1
AGENT_WEB_SEARCH_RESULTS=3

# ─── Guardrails (Buổi 7) ──────────────────────────────────────────────────────
# Bật thêm LLM-based injection check ngoài regex (tốn 1 lời gọi LLM/request).
GUARDRAILS_LLM_INJECTION_CHECK=false
GUARDRAILS_MIN_ANSWER_LEN=10

# ─── Monitoring — LangSmith (Buổi 7, Section 4; Module III Bài 2: eval pipeline) ──
# Tắt mặc định — bật khi đã có project LangSmith (smith.langchain.com).
MONITORING_ENABLED=false
LANGSMITH_API_KEY=lsv2_pt_your-key-here
LANGSMITH_PROJECT=llm-engineer-demo
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ─── Prompt Registry — LangSmith Prompt Hub (Module III, Bài 6) ───────────────
# local     = dùng hằng số trong app/prompts/templates.py (mặc định: test/CI
#             chạy hermetic, không gọi mạng).
# langsmith = pull prompt lúc runtime theo alias, có cache đĩa + fallback.
# Prompt trên LangSmith đặt tên "<LANGSMITH_PROJECT>-<name>", vd
# llm-engineer-demo-rag-answer. Push bằng: python -m app.prompts.push
PROMPT_REGISTRY=local
PROMPT_CACHE_DIR=data/prompt_cache
# Đổi sang "staging" để thử version mới mà không đụng production.
# Rollback = trỏ alias về commit cũ: python scripts/prompt_rollback.py --previous
PROMPT_ALIAS=production

# ─── App ─────────────────────────────────────────────────────────────────────
APP_NAME=Vietnamese Legal Assistant
LOG_LEVEL=INFO

# ─── Async serving (Module III, Bài 4, Section 4) ────────────────────────────
LLM_MAX_CONCURRENCY=20
LLM_TIMEOUT_SECONDS=30.0

# ─── Cache tầng 1 qua Redis (Module III, Bài 4, Section 1) ───────────────────
# Chỉ cần khi chạy app/cost/cache_redis.py::RedisStore (docker-compose service `redis`).
REDIS_URL=redis://localhost:6379

# ─── Secret Management (Module III, Bài 5, Section 4) ────────────────────────
# Local dev: để false, dùng các key ở trên trong .env như bình thường.
# Production (deploy/startup.sh đặt biến này = true): đọc OPENAI_API_KEYS,
# TAVILY_API_KEY, LANGSMITH_API_KEY từ GCP Secret Manager lúc runtime thay vì
# .env — xem deploy/README.md mục "Secret Manager".
USE_SECRET_MANAGER=false
GCP_PROJECT_ID=
